# QuickNotes Environment Variables Configuration Template
# Copy this file to a new file named '.env' and fill in your actual credentials.

# Flask settings
SECRET_KEY=quicknotes
SALT=quicknotes_salt

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=vasu
DB_NAME=quicknotes

# Email SMTP Settings (Gmail)
# To use Gmail, you must enable 2-Step Verification and generate an "App Password"
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
